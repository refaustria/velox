[Unit]
Description=Velox game server (%i)
Documentation=https://games.inceptum.at/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=velox
Group=velox
# Per-instance settings; the optional password (VELOX_SERVER_PASSWORD) lives only here, never on the command line.
EnvironmentFile=/srv/velox/config/%i.env
WorkingDirectory=/srv/velox
# UE and helper libraries look at $HOME; keep it inside the one writable tree.
Environment=HOME=/srv/velox/saved/%i
ExecStart=/srv/velox/bin/run-server.sh %i
Restart=on-failure
RestartSec=5
# SIGTERM is a graceful UE exit; the stop timeout only exists for a hung shutdown. control-group also reaps stray children.
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
Nice=-5
LimitCORE=0
LimitNOFILE=65536
MemoryMax=6G

# Hardening. The only writable path is the saved tree (logs, config cache, -UserDir). Releases are read-only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/velox/saved
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
