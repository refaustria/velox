# Instance settings for velox-server@<instance>.service. Copy to /srv/velox/config/<instance>.env
# (root:velox, mode 0640) -- install-server.sh does this for "ffa" if the file is missing. Never commit a real file.
# Read by systemd (EnvironmentFile) and then by /srv/velox/bin/run-server.sh. Values with spaces need no quotes.

# listen = packaged Development build as headless listen server (ADR 0007 1a); editor = UnrealEditor-Cmd -server (1b fallback).
VELOX_SERVER_MODE=listen
# Map and game mode (ModeTag leaf, FFA or Duel).
VELOX_MAP=L_DM1
VELOX_MODE=FFA
# UDP port; one port per instance (open it in infra/firewall/nftables.conf).
VELOX_PORT=7777
VELOX_MAXPLAYERS=16
# The headless host itself occupies one spectator slot (AGameSession::AtCapacity counts it), so 5 = 4 real spectators.
VELOX_MAXSPECTATORS=5
# Extra URL options, each starting with '?'.
VELOX_BOT_OPTIONS=?Bots=3?BotsFill=1?BotDifficulty=Medium
# Shown in the server list (servers.json). The id is the instance name (the unit passes -ServerId=<instance>).
VELOX_SERVER_NAME=Velox FFA | games.inceptum.at
# Release to run. The "current" symlink is switched by release.sh.
#VELOX_RELEASE_DIR=/srv/velox/current
# Editor mode only: checkout containing Velox.uproject, and the engine root.
#VELOX_PROJECT_DIR=/srv/velox/releases/<ver>-editor
#UE_ROOT=/opt/UnrealEngine-5.8

# Join password. Empty / unset = open server. The game reads this variable itself (task 07); it is deliberately NOT passed
# as -ServerPassword= because the engine logs the command line. Keep this file 0640 root:velox.
#VELOX_SERVER_PASSWORD=
