# Copy to /etc/veloxmaster.env (root:veloxmaster, mode 0640). Never commit the real file.
VELOXMASTER_LISTEN=127.0.0.1:8790
VELOXMASTER_OUTPUT=/var/www/games.inceptum.at/status/servers.json
VELOXMASTER_PUBLIC_ADDRESS=77.244.242.34
VELOXMASTER_TTL_S=90
VELOXMASTER_WRITE_INTERVAL_S=15
# Optional: when set, heartbeats must carry a matching "token" field.
#VELOXMASTER_TOKEN=
