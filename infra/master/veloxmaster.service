[Unit]
Description=Velox server directory (heartbeats in, servers.json out)
After=network.target

[Service]
User=veloxmaster
Group=veloxmaster
EnvironmentFile=/etc/veloxmaster.env
ExecStart=/srv/veloxmaster/veloxmaster
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/www/games.inceptum.at/status
MemoryMax=256M

[Install]
WantedBy=multi-user.target
